# Odoo instance configuration
ODOO_BASE_URL=http://localhost:8069
ODOO_DB=odoo17

# Admin credentials (used for setup and master data creation)
ADMIN_EMAIL=admin
ADMIN_PASSWORD=admin

# Role-based test users (must exist in Odoo before running tests)
MANAGER_EMAIL=hr_manager@example.com
MANAGER_PASSWORD=manager_pass

EMPLOYEE_EMAIL=hr_employee@example.com
EMPLOYEE_PASSWORD=employee_pass

# Test run configuration
HEADLESS=true
SLOW_MO=0

# Set to true to keep test records visible in Odoo after the run (for debugging).
# Default (false) archives all created records when tests finish.
SKIP_ARCHIVE=false

# Sales Cash/Credit flow test (npm run test:sales-flows) — creates real records, opt-in
# Separate approver login: the requesting user cannot approve their own Credit Limit / Overdue request.
ODOO_APPROVER_EMAIL=
ODOO_APPROVER_PASSWORD=
# Optional: FLOW_GROUPS=DISTR,CAC  FLOW_CONTROL_CUSTOMER=abc|none  FLOW_NO_EXTRAS=true
